{
  "name": "db-api",
  "version": "1.0.0",
  "description": "Secure Database API Gateway for local PostgreSQL with monitoring, SQL firewall, and granular access control",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').cpSync('src/public', 'dist/public', {recursive: true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup:db": "tsx scripts/setup-db.ts",
    "test:client": "tsx scripts/test-client.ts"
  },
  "keywords": [
    "postgresql",
    "database-api",
    "security-gateway",
    "sql-firewall",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
